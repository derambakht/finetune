# Copy to .env and adjust:  cp .env.example .env
# Docker Compose reads this file automatically.

# --- Security -------------------------------------------------------------
# Login for the web UI (strongly recommended on any public server).
# Format: user:password  — several users: alice:pass1,bob:pass2
FTSTUDIO_AUTH=admin:change-me-please

# --- Network --------------------------------------------------------------
FTSTUDIO_PORT=7860
# 0.0.0.0 = reachable from other machines; 127.0.0.1 = only via SSH tunnel / reverse proxy
FTSTUDIO_BIND=0.0.0.0
# Set when serving behind a reverse proxy under a sub-path, e.g. /ftstudio
GRADIO_ROOT_PATH=

# --- Hugging Face / tracking ---------------------------------------------
# Needed for gated models (Llama, Gemma) and for pushing models to the Hub.
HF_TOKEN=
WANDB_API_KEY=

# --- Storage (host paths) -------------------------------------------------
OUTPUTS_DIR=./outputs
DATA_DIR=./data
CONFIGS_DIR=./configs

# --- GPU ------------------------------------------------------------------
# Index of the GPU used for training (as listed by nvidia-smi). Unsloth trains on a single GPU.
CUDA_VISIBLE_DEVICES=0
SHM_SIZE=16gb

# --- Build ----------------------------------------------------------------
# CUDA base image (must be supported by your host driver: see `nvidia-smi`)
CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04
# Pin Unsloth for reproducible images, e.g. "unsloth==2026.9.1 unsloth_zoo==2026.9.1"
UNSLOTH_SPEC=unsloth unsloth_zoo
